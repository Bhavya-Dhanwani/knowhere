PORT=5007
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=chatService
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3100
USER_SERVICE_URL=http://localhost:5001
# Access tokens are RS256. Leave these empty locally (dev keys are built in); production
# refuses to start without them. Generate real ones with `pnpm keys`.
ACCESS_TOKEN_PUBLIC_KEY=
SERVICE_TOKEN_SECRET=
# voice channels (LiveKit SFU); LIVEKIT_URL is what browsers connect to
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
