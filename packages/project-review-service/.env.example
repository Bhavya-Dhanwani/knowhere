PORT=5006
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/projectReviewService
CORS_ORIGIN=*
# Access tokens are RS256. Leave these empty locally (dev keys are built in); production
# refuses to start without them. Generate real ones with `pnpm keys`.
ACCESS_TOKEN_PUBLIC_KEY=
TEMPORAL_ADDRESS=localhost:7233

# Unlimited Mistral API Keys supported via:
# 1. Comma/newline separated MISTRAL_API_KEYS="key1,key2,key3,..."
# 2. Individual indexed keys: MISTRAL_API_KEY1=..., MISTRAL_API_KEY2=..., MISTRAL_API_KEY_N=...
# MISTRAL_API_KEYS=key1,key2,key3
MISTRAL_API_KEY1=your_mistral_api_key_1
MISTRAL_API_KEY2=your_mistral_api_key_2

# Submissions evaluated at once by "Run on all submissions" (each clones a repo + calls the LLM)
REVIEW_CONCURRENCY=3

# Read-only GitHub token (no scopes needed for public repos): 5000 req/h instead of 60
GITHUB_TOKEN=
# Chromium for live-site audits. Empty = use the locally installed Google Chrome
CHROMIUM_PATH=
# The one model used for all grading. Failover rotates API keys, never the model.
MISTRAL_MODEL=mistral-medium-latest
# judge-runner base URL: builds + runs tests for every submission in its offline sandbox (empty = skip)
JUDGE_URL=http://localhost:5010
