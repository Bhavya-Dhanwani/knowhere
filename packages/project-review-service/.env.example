PORT=5006
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/project-review
REDIS_URL=redis://localhost:6379
EVALUATION_WORKER_CONCURRENCY=2
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000

# Comma-separated pool. Keys are rotated round-robin and cooled down after rate limits.
MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-medium-latest

# Authenticated, network-isolated runner control-plane endpoints.
EXECUTION_EVALUATION_RUNNER_URL=
STATIC_ANALYSIS_RUNNER_URL=
BROWSER_EVALUATION_RUNNER_URL=
API_EVALUATION_RUNNER_URL=
EVALUATION_RUNNER_TOKEN=
EVALUATION_WORKSPACE_ROOT=
ALLOW_LOCAL_TRUSTED_ANALYZERS=false

# Per-stage ceilings in milliseconds.
REPOSITORY_CLONE_TIMEOUT_MS=120000
EXECUTION_EVALUATION_TIMEOUT_MS=1200000
BROWSER_EVALUATION_TIMEOUT_MS=600000
API_EVALUATION_TIMEOUT_MS=900000
