{
  "name": "@lms/media-service",
  "version": "1.0.0",
  "description": "Media and Transcoding Service for LMS",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
