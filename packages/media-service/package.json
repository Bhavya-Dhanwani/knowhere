    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.8.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "glob": "^13.0.6",
    "test-exclude": "^7.0.1",
