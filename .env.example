# ==============================================================================
# KNOWHERE LMS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: All services have built-in local defaults and WILL RUN WITHOUT THIS FILE!
# Copy this file to .env if you want to override defaults or enable external providers.

# ------------------------------------------------------------------------------
# Core Infrastructure (Required to be running locally or in Docker)
# ------------------------------------------------------------------------------
MONGO_BASE_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Common Microservice JWT Secrets
# ------------------------------------------------------------------------------
# Access tokens are RS256. Leave these empty locally (dev keys are built in); production
# refuses to start without them. Generate real ones with `pnpm keys`.
ACCESS_TOKEN_PRIVATE_KEY=
ACCESS_TOKEN_PUBLIC_KEY=
SERVICE_TOKEN_SECRET=
MEDIA_SIGNING_SECRET=
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_change_in_production

# ------------------------------------------------------------------------------
# Auth Service (Port: 5000)
# ------------------------------------------------------------------------------
# Optional: Email verification (defaults to false for local dev)
SEND_MAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_USER="Knowhere LMS <noreply@knowhere.dev>"

# Optional: Google OAuth (leave empty to use password auth only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# Project Review Service (Port: 5006)
# ------------------------------------------------------------------------------
# Required ONLY if running AI auto-evaluation of code submissions:
MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-medium-latest

# Optional Alternative LLM / Sandboxes:
E2B_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TEMPORAL_ADDRESS=

# ------------------------------------------------------------------------------
# Media Service (Port: 5003)
# ------------------------------------------------------------------------------
# Optional: Only needed for real AWS S3 transcoding & video uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test_access_key
AWS_SECRET_ACCESS_KEY=test_secret_key
S3_RAW_BUCKET=lms-raw-media
S3_TRANSCODED_BUCKET=lms-transcoded-media
CLOUDFRONT_DOMAIN=https://cdn.example.com

# judge-runner and LiveKit
JUDGE_URL=http://localhost:5010
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
